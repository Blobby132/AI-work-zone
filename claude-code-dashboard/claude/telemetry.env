# Shell-export form of claude/settings-snippet.json, for one-off sessions:
#   source claude-code-dashboard/claude/telemetry.env && claude
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Default is 60s for metrics / 5s for logs. A 10s metric interval means a
# short session still lands at least one data point before the process exits.
export OTEL_METRIC_EXPORT_INTERVAL=10000
export OTEL_LOGS_EXPORT_INTERVAL=5000

# Off by default; uncomment to attribute usage across a team. These become
# Prometheus labels via the collector's resource_to_telemetry_conversion.
# export OTEL_RESOURCE_ATTRIBUTES="department=engineering,team.id=platform"

# Off by default and worth keeping that way: these ship prompt text, model
# responses, tool commands and tool output into Loki in the clear.
# export OTEL_LOG_USER_PROMPTS=1
# export OTEL_LOG_ASSISTANT_RESPONSES=1
# export OTEL_LOG_TOOL_DETAILS=1
