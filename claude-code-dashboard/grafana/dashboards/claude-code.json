    {
      "id": 9,
      "type": "stat",
      "title": "Cache hit rate",
      "description": "cacheRead over all context-bearing input tokens. High is good: cache reads are billed at a fraction of fresh input.",
      "datasource": {
        "type": "prometheus",
        "uid": "cc-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cc-prometheus"
          },
          "expr": "sum(max_over_time(claude_code_token_usage{type=\"cacheRead\"}[$__range])) / clamp_min(sum(max_over_time(claude_code_token_usage{type=~\"input|cacheRead|cacheCreation\"}[$__range])), 1)",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
