    {
      "id": 11,
      "type": "timeseries",
      "title": "Session spend over time",
      "description": "Spend of the sessions active in each bucket. A session spanning two buckets appears in both, so the bars show when and how heavily you worked, not a sum you can add up -- the Spend tile above is the exact total. rate() and increase() read zero on this data; see the README.",
      "datasource": {
        "type": "prometheus",
        "uid": "cc-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cc-prometheus"
          },
          "expr": "sum by (model) (max_over_time(claude_code_cost_usage{model=~\"$model\"}[$__interval]))",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "barAlignment": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto",
            "gradientMode": "opacity",
            "lineInterpolation": "smooth"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10m"
    },
